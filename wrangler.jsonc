{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-08",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "astro-scholar",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "lohith.io",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}