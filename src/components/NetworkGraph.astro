---
// src/components/NetworkGraph.astro
interface NodeData {
  id: string;
  label: string;
  color?: string;
}

interface EdgeData {
  source: string;
  target: string;
  weight?: number;
}

interface Props {
  nodes: NodeData[];
  edges: EdgeData[];
  isDirected?: boolean;  // Added configuration flag
  isWeighted?: boolean;  // Added configuration flag
}

// Default to true to maintain backward compatibility
const { nodes, edges, isDirected = true, isWeighted = true } = Astro.props;

// Format the elements array for Cytoscape
const elements = [
  ...nodes.map((n) => ({
    data: { id: n.id, label: n.label, color: n.color || "#3b82f6" },
  })),
  ...edges.map((e) => ({
    data: { 
      source: e.source, 
      target: e.target, 
      // If unweighted, we pass undefined so Cytoscape won't render a blank text bubble
      weight: isWeighted ? e.weight : undefined 
    },
  })),
];
---

<div
  id="cy"
  data-elements={JSON.stringify(elements)}
  data-directed={String(isDirected)}
  data-weighted={String(isWeighted)}
  style="width: 100%; height: 400px; background-color: #1e1e24; border-radius: 8px; margin: 20px 0;">
</div>

<script>
  import cytoscape from "cytoscape";
  import dagre from "cytoscape-dagre";

  cytoscape.use(dagre);

  const container = document.getElementById("cy");

  if (container) {
    const elements = JSON.parse(container.dataset.elements || "[]");
    // Read the true/false flags from the HTML data attributes
    const isDirected = container.dataset.directed === "true";
    const isWeighted = container.dataset.weighted === "true";

    cytoscape({
      container: container,
      elements: elements,
      style: [
        {
          selector: "node",
          style: {
            "background-color": "data(color)",
            label: "data(label)",
            width: "48px",
            height: "48px",
            color: "#ffffff",
            "font-weight": "bold",
            "font-size": "12px",
            "text-valign": "center",
            "text-halign": "center",
            "border-width": "3px",
            "border-color": "#ffffff",
          },
        },
        {
          selector: "edge",
          style: {
            width: 2,
            "line-color": "#6366f1",
            "target-arrow-color": "#6366f1",
            // Dynamically remove the arrow shape if undirected
            "target-arrow-shape": isDirected ? "triangle" : "none",
            "curve-style": "bezier",
            // Dynamically remove the label text and its background if unweighted
            label: isWeighted ? "data(weight)" : "",
            color: "#e0e7ff",
            "font-size": "10px",
            "text-background-color": "#2d2d3d",
            "text-background-opacity": isWeighted ? 1 : 0,
            "text-background-padding": "4px",
          },
        },
      ],
      layout: {
        name: "dagre",
        rankDir: "TB",
        nodeSep: 50,
        rankSep: 70,
      } as cytoscape.LayoutOptions,
    });
  }
</script>