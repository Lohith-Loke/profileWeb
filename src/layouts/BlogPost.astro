---
import Layout from "./Layout.astro";
import "../styles/blog.css";
import "katex/dist/katex.min.css";
const { frontmatter } = Astro.props;

const dateStr = new Date(frontmatter.date).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout pageTitle={frontmatter.title}>
  <div class="page-container">
    <div class="post-header">
      <a href={`${import.meta.env.BASE_URL}blog/`} class="back-link">← Blog</a>
      <h1 class="post-title">{frontmatter.title}</h1>
      <div class="post-meta">
        <time datetime={frontmatter.date}>{dateStr}</time>
        {
          frontmatter.tags && (
            <div class="post-tags">
              {frontmatter.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
      {
        frontmatter.description && (
          <p class="post-description">{frontmatter.description}</p>
        )
      }
    </div>

    <article class="post-body">
      <slot />
    </article>

    <div class="post-footer">
      <a href={`${import.meta.env.BASE_URL}blog/`} class="back-link"
        >← Back to all posts</a
      >
    </div>
  </div>
</Layout>

<script>
  // Find all <pre> tags generated by Markdown code blocks
  const blocks = document.querySelectorAll("pre");

  blocks.forEach((block) => {
    // Only add button if the browser supports standard clipboard APIs
    if (navigator.clipboard) {
      // Create the wrapper/container if needed, or style pre as relative
      block.style.position = "relative";

      // Create the button
      const button = document.createElement("button");
      button.className = "copy-code-button";
      button.innerText = "Copy";

      block.appendChild(button);

      button.addEventListener("click", async () => {
        await copyCode(block, button);
      });
    }
  });
  async function copyCode(block: HTMLElement, button: HTMLButtonElement) {
    // Astro wraps markdown code inside standard <pre><code> structures
    const code = block.querySelector("code");
    const text = code ? code.innerText : block.innerText;

    // Copy text to clipboard
    await navigator.clipboard.writeText(text);

    // Visual feedback
    button.innerText = "Copied!";
    button.classList.add("copied");

    setTimeout(() => {
      button.innerText = "Copy";
      button.classList.remove("copied");
    }, 2000);
  }
</script>
